{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".opencode/preferences.md",
    ".github/AI_PREFERENCES.md"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rm -rf *": "ask",
      "git push *": "ask",
      "git push --force *": "deny",
      "git reset --hard *": "ask",
      "sudo *": "ask",
      "curl * | *": "ask",
      "wget * | *": "ask"
    }
  }
}